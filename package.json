{
  "name": "dsh-doudizhu",
  "version": "0.1.1",
  "description": "Standalone trusted-LAN Dou Dizhu plugin bundle for DeepSeek Harness",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y1fe1Zh0u/dsh-doudizhu.git"
  },
  "homepage": "https://github.com/Y1fe1Zh0u/dsh-doudizhu#readme",
  "bugs": "https://github.com/Y1fe1Zh0u/dsh-doudizhu/issues",
  "type": "module",
  "sideEffects": [
    "./lib/client.js"
  ],
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES/"
  ],
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./room": {
      "types": "./lib/types/room/index.d.ts",
      "default": "./lib/room.js"
    },
    "./agent": {
      "types": "./lib/types/agent/index.d.ts",
      "default": "./lib/agent.js"
    },
    "./persistence": {
      "types": "./lib/types/persistence/index.d.ts",
      "default": "./lib/persistence.js"
    },
    "./transport": {
      "types": "./lib/types/transport/index.d.ts",
      "default": "./lib/transport.js"
    },
    "./transport/client": {
      "types": "./lib/types/transport/client.d.ts",
      "default": "./lib/types/transport/client.js"
    },
    "./doudizhu": {
      "types": "./lib/types/doudizhu/index.d.ts",
      "default": "./lib/doudizhu.js"
    },
    "./doudizhu-runtime": {
      "types": "./lib/types/doudizhu-runtime/index.d.ts",
      "default": "./lib/doudizhu-runtime.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./room/invariant": {
      "types": "./lib/types/room/invariant.d.ts",
      "default": "./lib/room-invariant.js"
    },
    "./agent/invariant": {
      "types": "./lib/types/agent/invariant.d.ts",
      "default": "./lib/agent-invariant.js"
    },
    "./persistence/invariant": {
      "types": "./lib/types/persistence/invariant.d.ts",
      "default": "./lib/persistence-invariant.js"
    },
    "./transport/invariant": {
      "types": "./lib/types/transport/invariant.d.ts",
      "default": "./lib/transport-invariant.js"
    },
    "./doudizhu/invariant": {
      "types": "./lib/types/doudizhu/invariant.d.ts",
      "default": "./lib/doudizhu-invariant.js"
    },
    "./doudizhu-runtime/invariant": {
      "types": "./lib/types/doudizhu-runtime/invariant.d.ts",
      "default": "./lib/doudizhu-runtime-invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:host": "tsdown --config tsdown.host.config.ts && node scripts/copy-generated.mjs",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build": "npm run clean && npm run build:types && npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests scripts *.ts",
    "test": "vitest run",
    "check:pack": "node scripts/check-pack.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:pack",
    "prepack": "npm run build && npm run check:pack -- --staged"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-sqlite": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.0-rc.8",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-subagent-report": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "^8.18.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "oxlint": "1.76.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
